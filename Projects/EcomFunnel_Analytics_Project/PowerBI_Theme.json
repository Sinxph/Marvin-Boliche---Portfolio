{
    "name": "Coupler Ecom Theme",
    "dataColors": [
        "#6366f1",
        "#1e40af",
        "#0ea5e9",
        "#10b981",
        "#f43f5e",
        "#8b5cf6",
        "#9ca3af"
    ],
    "background": "#ffffff",
    "foreground": "#334155",
    "tableAccent": "#1e40af",
    "visualStyles": {
        "*": {
            "*": {
                "*": [
                    {
                        "fontFamily": "Segoe UI, sans-serif",
                        "fontSize": 10,
                        "color": { "solid": { "color": "#475569" } }
                    }
                ],
                "background": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#f8fafc" } },
                        "transparency": 0
                    }
                ],
                "border": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#e2e8f0" } },
                        "radius": 4
                    }
                ]
            }
        }
    }
}
